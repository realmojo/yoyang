# Supabase — keywordegg 와 같은 프로젝트를 쓰고, 테이블만 yoyang_ 접두사로 나눈다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_BASE_URL=https://yoyang.keywordegg.com

# 검색엔진 소유확인 (비워 두면 해당 태그가 들어가지 않는다)
# 서치콘솔·서치어드바이저에 yoyang.keywordegg.com 을 등록한 뒤 받은 값을 넣는다
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# 다음 웹마스터도구가 robots.txt 주석으로 확인하는 문자열 (#DaumWebMasterTool:... 전체)
DAUM_VERIFICATION=

# Google Analytics 측정 ID (G-XXXXXXXXXX). 비워 두면 gtag 를 넣지 않는다
NEXT_PUBLIC_GA_ID=

# ── 공공데이터포털 (평가 결과 적재용. 사이트 런타임에는 쓰지 않는다) ──
# 15104801 장기요양기관 평가 결과: https://www.data.go.kr/data/15104801/fileData.do
# 활용신청 후 마이페이지 > 인증키 > 일반 인증키(Decoding) 값을 넣는다.
# Encoding 키를 넣어도 동작하지만(스크립트가 판별한다) Decoding 쪽을 권한다.
DATA_GO_KR_SERVICE_KEY=
# 데이터셋 상세의 "오픈 API" 탭에서 복사한 요청 URL (serviceKey·page·perPage 제외)
YOYANG_EVAL_API_URL=
# 한 번에 받을 행 수 (기본 1000)
YOYANG_EVAL_PER_PAGE=
